__pycache__/
*.DS_Store
.idea/
.vscode/
data/output_data/
/analysis/
/tmp/
*.ipynb

# Generated experiment products. Keep reproducible source, configs and raw inputs
# under version control; keep simulator replays, figures, logs and checkpoints out.
/final_result/*
!/final_result/.gitkeep
*.log
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.pkl
*.pickle
*.h5
*.hdf5
*.onnx
*.fcd.xml
*.vehroute.xml
*.tripinfo.xml
*.summary.xml
*.netstate.xml
*.sqlite

# Local images and ad-hoc exports generated during analysis.
*.png
*.jpg
*.jpeg

# Do not commit shell wrappers or local caches.
*.sh
!dev/checks/*.sh
*.ipynb
/.secrets/

# Runtime coordination artifacts (queues / claims / eval bundles) — runtime state, not versioned.
/artifacts/*
!/artifacts/wiki_claims/
/artifacts/wiki_claims/*
!/artifacts/wiki_claims/README.md

# feishu 实例指针配置（本地部署用，勿入库）
configs/feishu.json
